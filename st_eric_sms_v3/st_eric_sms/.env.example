# St Eric High School SMS
SECRET_KEY=change-me-to-a-long-random-string-32-chars-min
DATABASE_URL=postgresql+psycopg2://steric:steric_pw@db:5432/steric_sms
POSTGRES_USER=steric
POSTGRES_PASSWORD=steric_pw
POSTGRES_DB=steric_sms
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
# Existing fee system (read-only). Leave blank until the school provides access.
FEE_SYSTEM_URL=
FEE_SYSTEM_DB_URL=
PUBLIC_URL=http://localhost          # the address parents use; printed inside report-card QR codes
MAX_UPLOAD_MB=50
# Optional AI comment drafting (Claude). Leave blank to use the built-in offline writer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Existing fee system, read-only. The query must be a SELECT returning these columns:
# external_student_id (= the learner's admission number), external_fee_id, fee_type, currency (USD or ZWG), amount_due, amount_paid
FEE_SYSTEM_DB_URL=
FEE_SYSTEM_QUERY=
